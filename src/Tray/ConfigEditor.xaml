<Window x:Class="FeeSyncer.Tray.ConfigEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — FeeSyncer" Width="700" SizeToContent="Height"
        MinWidth="620" MinHeight="560" MaxHeight="1000"
         WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
         ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Configuration" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
        <TabControl Grid.Row="1">
            <TabItem Header="SMS Service">
                <Grid x:Name="SmsSection">
                <StackPanel Margin="10">
                        <TextBlock Text="Database" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Server:" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="DbServerBox" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Database:" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="DbNameBox" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="User ID:" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="DbUserIdBox" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Password:" VerticalAlignment="Center"/><PasswordBox Grid.Row="3" Grid.Column="1" x:Name="DbPasswordBox" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="SMS API" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="URL:" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="ApiUrlBox" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Authorization token:" VerticalAlignment="Center"/><PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TokenBox" Margin="0,2"/>
                        </Grid>
                        <TextBlock Text="Retry and Logging" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Retry backoff (s):" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="BackoffBox" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Retry poll interval (s):" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="PollIntervalBox" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Log retention (days):" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="RetentionBox" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Max log size (MB):" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxSizeBox" Margin="0,2"/>
                        </Grid>
                        <Button Content="Test SMS Connections" x:Name="TestSmsButton" Click="TestSmsButton_Click" HorizontalAlignment="Left" Padding="12,4" Margin="0,12,0,0"/>
                </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="School Agent">
                <Grid x:Name="AgentSection">
                <StackPanel Margin="10">
                    <TextBlock Text="Enrollment" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Single-use code from fee-syncer; it is never stored." Foreground="Gray" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Enrollment code:"/><TextBox x:Name="EnrollmentCodeBox" Margin="0,2"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Agent name:"/><TextBox x:Name="AgentNameBox" Margin="0,2"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Agent and Local API" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Enabled:"/><CheckBox x:Name="AgentEnabledBox" Margin="0,5"/><TextBlock Text="Gateway URL:"/><TextBox x:Name="AgentServerUrlBox" Margin="0,2"/><TextBlock Text="Agent token:"/><TextBox x:Name="AgentTokenBox" Margin="0,2"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Local API URL:"/><TextBox x:Name="LocalApiUrlBox" Margin="0,2"/><TextBlock Text="Username:"/><TextBox x:Name="LocalApiUsernameBox" Margin="0,2"/><TextBlock Text="Password:"/><PasswordBox x:Name="LocalApiPasswordBox" Margin="0,2"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Timing and MQTT" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Request timeout"/><TextBox x:Name="RequestTimeoutBox"/><TextBlock Text="Idle delay" Margin="0,4,0,0"/><TextBox x:Name="IdleDelayBox"/><TextBlock Text="Heartbeat" Margin="0,4,0,0"/><TextBox x:Name="HeartbeatBox"/><TextBlock Text="Lease renewal" Margin="0,4,0,0"/><TextBox x:Name="LeaseRenewalBox"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="MQTT enabled"/><CheckBox x:Name="MqttEnabledBox" Margin="0,5"/><TextBlock Text="Broker host"/><TextBox x:Name="MqttHostBox"/><TextBlock Text="Broker port" Margin="0,4,0,0"/><TextBox x:Name="MqttPortBox"/><TextBlock Text="TLS" Margin="0,4,0,0"/><CheckBox x:Name="MqttTlsBox" Margin="0,5"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="MQTT username"/><TextBox x:Name="MqttUsernameBox"/><TextBlock Text="MQTT password" Margin="0,4,0,0"/><PasswordBox x:Name="MqttPasswordBox"/><TextBlock Text="Topic prefix" Margin="0,4,0,0"/><TextBox x:Name="MqttTopicBox"/><TextBlock Text="Keep alive" Margin="0,4,0,0"/><TextBox x:Name="MqttKeepAliveBox"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Reconnect min"/><TextBox x:Name="MqttReconnectMinBox"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Reconnect max"/><TextBox x:Name="MqttReconnectMaxBox"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Agent status"/><TextBlock x:Name="AgentStatusSummaryText" Margin="0,5" Foreground="Gray"/></StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Enroll / Re-enroll" x:Name="EnrollButton" Click="EnrollButton_Click" Padding="12,4" Margin="0,0,8,0"/>
                            <Button Content="Test Agent Connections" x:Name="TestAgentButton" Click="TestAgentButton_Click" Padding="12,4" Margin="0,0,8,0"/>
                            <TextBlock x:Name="AgentStatusText" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>
                </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Fee Processor Updates">
                <StackPanel Margin="10">
                    <TextBlock Text="Automatic Fee Processor Updates" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Enabled"/><CheckBox x:Name="FeeUpdateEnabledBox" Margin="0,5"/>
                            <TextBlock Text="Application directory"/><TextBox x:Name="FeeUpdatePathBox" Margin="0,2"/>
                            <TextBlock Text="Repository"/><TextBox x:Name="FeeUpdateRepositoryBox" Margin="0,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Branch"/><TextBox x:Name="FeeUpdateBranchBox" Margin="0,2"/>
                            <TextBlock Text="Tag (optional)"/><TextBox x:Name="FeeUpdateTagBox" Margin="0,2"/>
                            <TextBlock Text="Interval / Backup directory"/>
                            <DockPanel><TextBox x:Name="FeeUpdateIntervalBox" Width="55"/><TextBox x:Name="FeeUpdateBackupBox" Margin="6,0,0,0"/></DockPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Use * in Tag to deploy the latest remote tag. A tag takes precedence over Branch." Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Pull Updates Now" x:Name="PullFeeUpdateButton" Click="PullFeeUpdateButton_Click" Padding="12,4"/>
                        <TextBlock x:Name="FeeUpdateStatusText" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ProgressBar x:Name="FeeUpdateProgressBar" Height="8" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/>
                    <TextBox x:Name="FeeUpdateOutputBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="120" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ConfigPathText" FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save All" x:Name="SaveButton" Click="SaveButton_Click" Margin="0,0,8,0" Padding="12,4"/>
                <Button Content="Cancel" Click="CancelButton_Click" Padding="12,4"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
