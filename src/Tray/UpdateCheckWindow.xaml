<Window x:Class="FeeSyncer.Tray.UpdateCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check for Updates" Width="600" Height="560"
        MinWidth="540" MinHeight="500" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="FeeSyncer Update Check" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Compare this installation with the latest published update."
                       Margin="0,5,0,0" Foreground="#5F6B7A" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,16" Padding="15" CornerRadius="8"
                BorderBrush="#D8DEE9" BorderThickness="1" Background="#F8FAFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Installed version" FontWeight="SemiBold" Margin="0,0,20,8"/>
                <TextBlock x:Name="CurrentVersionText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Latest release" FontWeight="SemiBold" Margin="0,0,20,8"/>
                <TextBlock x:Name="LatestVersionText" Grid.Row="1" Grid.Column="1" Text="Checking..." Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Published" FontWeight="SemiBold" Margin="0,0,20,8"/>
                <TextBlock x:Name="PublishedText" Grid.Row="2" Grid.Column="1" Text="Checking..." Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Installer" FontWeight="SemiBold" Margin="0,0,20,8"/>
                <TextBlock x:Name="InstallerText" Grid.Row="3" Grid.Column="1" Text="Self-contained Windows x64" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Source" FontWeight="SemiBold" Margin="0,0,20,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Munywele public S3 update channel"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ProgressBar x:Name="Progress" Height="8" IsIndeterminate="True"/>
                <TextBlock x:Name="StatusTitleText" Text="Checking for updates..."
                           FontSize="16" FontWeight="SemiBold" Margin="0,16,0,5"/>
                <TextBlock x:Name="StatusDetailsText"
                           Text="Contacting the public S3 update channel and reading the latest release information. This can take a few moments."
                           Foreground="#5F6B7A" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="DownloadButton" Content="Download Installer" Click="Download_Click"
                    Visibility="Collapsed" Padding="14,6" Margin="0,0,8,0"/>
            <Button x:Name="CloseButton" Content="Cancel" Click="Close_Click"
                    Padding="18,6" MinWidth="88" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
