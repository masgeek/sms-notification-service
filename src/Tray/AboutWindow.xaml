<Window x:Class="FeeSyncer.Tray.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About FeeSyncer" Width="500" Height="470"
        MinWidth="460" MinHeight="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="FeeSyncer" FontSize="30" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" Margin="0,4,0,0" Foreground="#5F6B7A" FontSize="14"/>
            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="21"
                       Text="Windows services and management tools for SMS notification delivery and school data synchronization."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,22,0,18" Padding="16" CornerRadius="8"
                BorderBrush="#D8DEE9" BorderThickness="1" Background="#F8FAFC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="SMS service" FontWeight="SemiBold" Margin="0,0,18,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="FeeSyncer.Sms" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="School agent" FontWeight="SemiBold" Margin="0,0,18,8"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="FeeSyncer.Agent" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Management" FontWeight="SemiBold" Margin="0,0,18,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Tray and console applications"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Resources" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <TextBlock Margin="0,0,0,7">
                <Hyperlink NavigateUri="https://fees.munywele.co.ke/" RequestNavigate="Link_RequestNavigate">FeeSyncer service</Hyperlink>
            </TextBlock>
            <TextBlock>
                <Hyperlink NavigateUri="https://github.com/masgeek/sms-notification-service" RequestNavigate="Link_RequestNavigate">Source code and releases</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="RuntimeText" Margin="0,18,0,0" Foreground="#6B7280"/>
            <TextBlock x:Name="CopyrightText" Margin="0,5,0,0" Foreground="#6B7280"/>
        </StackPanel>

        <Button Grid.Row="3" Content="Close" Click="Close_Click" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Padding="18,6" MinWidth="88"/>
    </Grid>
</Window>
